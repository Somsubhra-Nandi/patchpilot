# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=INFO
POSTGRES_PASSWORD=patchpilot-local
DATABASE_URL=postgresql+psycopg://patchpilot:patchpilot-local@postgres:5432/patchpilot
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=true

# GitHub REST API. Write mode is opt-in and never merges automatically.
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
PATCHPILOT_DEMO_MODE=true
# Optional absolute path inside the API container for real validation commands.
DEMO_REPOSITORY_PATH=

# Optional LLM provider. The deterministic planner works without these values.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=deterministic-planner-v1

# Caspian SDK (verified against the official 0.6.x Python client).
CASPIAN_ENABLED=false
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_START_LISTENER=true

# Telegram: token created by @BotFather.
CASPIAN_TELEGRAM_BOT_TOKEN=

# Slack quick mode uses Caspian's hosted one-click app.
CASPIAN_SLACK_MODE=quick
CASPIAN_SLACK_DISPLAY_NAME=PatchPilot
CASPIAN_SLACK_ICON_URL=

# Slack branded OAuth mode (set CASPIAN_SLACK_MODE=branded).
CASPIAN_SLACK_CLIENT_ID=
CASPIAN_SLACK_CLIENT_SECRET=
CASPIAN_SLACK_SIGNING_SECRET=

# Slack Socket Mode alternative (set CASPIAN_SLACK_MODE=socket).
CASPIAN_SLACK_BOT_TOKEN=
CASPIAN_SLACK_APP_TOKEN=

